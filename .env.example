# URL pública del sitio (sin slash final). Úsala en metadataBase y sitemap.
NEXT_PUBLIC_SITE_URL=https://climaxpress.com

# Número de WhatsApp en formato internacional sin "+" (ej. 521XXXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=521XXXXXXXXXX

# Email de contacto para el formulario (fallback mailto)
NEXT_PUBLIC_CONTACT_EMAIL=contacto@climaxpress.com

# API key de Google Maps (solo servidor - no usar prefijo NEXT_PUBLIC_).
# Requiere habilitar Geocoding API y Distance Matrix API en Google Cloud Console.
GOOGLE_MAPS_API_KEY=
